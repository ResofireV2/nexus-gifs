gifs.billyrayfoss.com {
    # Reverse proxy to the nexus-gifs Phoenix service
    reverse_proxy localhost:4002

    # CORS headers on asset responses so Nexus can load the JS bundle
    @assets path /assets/*
    header @assets {
        Access-Control-Allow-Origin *
        Cache-Control "public, max-age=86400"
    }

    encode gzip
    log
}
